# Generated for real by:  azd env get-values > backend/.env
# Keyless — these are endpoints/IDs, not secrets. Auth is via DefaultAzureCredential.
AZURE_OPENAI_ENDPOINT="https://aoai-xxxx.openai.azure.com/"
AZURE_OPENAI_API_VERSION="2024-10-21"
AZURE_OPENAI_GPT4O_DEPLOYMENT="gpt-4o"
AZURE_OPENAI_GPT4O_MINI_DEPLOYMENT="gpt-4o-mini"
AZURE_OPENAI_OSERIES_DEPLOYMENT="o4-mini"
COSMOS_ENDPOINT="https://cosmos-xxxx.documents.azure.com:443/"
COSMOS_DATABASE="deliberations"
COSMOS_CONTAINER="events"
CONTENTSAFETY_ENDPOINT="https://cs-xxxx.cognitiveservices.azure.com/"
APPLICATIONINSIGHTS_CONNECTION_STRING="InstrumentationKey=...;IngestionEndpoint=..."
AZURE_CLIENT_ID=""   # managed identity client id (set on ACA; empty locally)

# Optional API guardrails (cost/abuse). Empty API_KEY = open endpoint (browser app default).
API_KEY=""
RATE_LIMIT_PER_MIN="5"
MAX_ACTIVE_DELIBERATIONS="3"
LLM_TIMEOUT_SECONDS="90"

# Catalog models (BACKEND_SETUP.md §4). Deployed as Global Standard on the same Foundry
# resource (not separate serverless URLs), so it's one inference endpoint + deployment names.
CATALOG_INFERENCE_ENDPOINT="https://aoai-xxxx.services.ai.azure.com/"
CATALOG_PHI4_DEPLOYMENT="Phi-4"
CATALOG_MISTRAL_DEPLOYMENT="Mistral-Large-3"
